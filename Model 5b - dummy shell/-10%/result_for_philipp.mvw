{ safe_quotes_on }
{ GRAPHIC_FILE_1 = "minustendummyshell.fem"}
{ RESULT_FILE_1 = "minustendummyshell.h3d"}
*Id("HyperWorks", "23.*")
*AnimationSyncPolicy(CLOSEST)
*BeginPalette()
*EndPalette()
*BeginMetaData()
*MetaData("HWFrontEnd", "HWFrontEnd", "UnityHybrid")
*EndMetaData()
*BeginPage() // Page 1
    *IsActive()
    *Name("page1")
    *Title("Untitled", Off)
    *TitleFont("Noto Sans", 1, 0, 12)
    *Layout(1)
    *BeginAnimator(Static)
        *CurrentPosition(25)
        *NumberOfSteps(25)
        *Increment(Forward, Frame, 1, BounceOff)
    *EndAnimator()
    *WindowIDs(3)
    *BeginWindow(Animation)         // Window 1
        *IsActive()
        *ExportFormat("PNG")
        *AnimationNote("")
        *BeginGraphic()
            *LightInfo(0, 0, 1, 0, 0, 0, 64)
            *RotationAngle(15)
            *BeginModel({GRAPHIC_FILE_1}, "OptiStruct Input Reader")
                *GlobalProperty("Convert 2nd order elements to 1st order elements", "No")
                *ReaderProperty("Model Organization", "By HM Comments")
                *ReaderProperty("Read ANSA Comments", "ON")
                *ReaderProperty("Read PATRAN Comments", "ON")
                *ReaderProperty("Use drive mapping", "NO")
                *ReaderProperty("Use new Element Pooling Scheme", "OFF")
                *ResultMathTemplate("Standard")
                *ComplexAnimFilter("mag * cos(wt+phase)")
                *ColorBy("Part")
                *Color("255   0   0")
                *GradientColor("Off")
                *SmallDeformation("Off")
                *PartDisplayAttribute("undefined", "undefined")
                *BeginResult({RESULT_FILE_1}, "Hyper3D Reader")
                    *CurrentSubcase(1, 0)
                    *ReaderProperty("Model Organization", "Default")
                    *ReaderProperty("Read Systems", "Default")
                *EndResult()
                *BeginPart(1, "Part", "PART", 0)
                    *Attribute(On, IdOff, #cccccc, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginPart(2, "Part", "PART", 0)
                    *Attribute(On, IdOff, #0000ff, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginPart(3, "Part", "PART", 0)
                    *Attribute(On, IdOff, #ffff00, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginGroup("0D Set", "Off", "Off", "255   0   0", 1, "wire")
                    *BeginSelection(Part, SelectAll, "User_Set", 1)
                        *Add("dimension == 0")
                    *EndSelection()
                *EndGroup()
                *BeginGroup("1D Set", "Off", "Off", "  0 255   0", 1, "wire")
                    *BeginSelection(Part, SelectAll, "User_Set", 2)
                        *Add("dimension == 1")
                    *EndSelection()
                *EndGroup()
                *BeginGroup("2D Set", "Off", "Off", "  0   0 255", 1, "wire")
                    *BeginSelection(Part, SelectAll, "User_Set", 3)
                        *Add("dimension == 2")
                    *EndSelection()
                *EndGroup()
                *BeginGroup("3D Set", "Off", "Off", "255 255   0", 1, "wire")
                    *BeginSelection(Part, SelectAll, "User_Set", 4)
                        *Add("dimension == 3")
                    *EndSelection()
                *EndGroup()
                *BeginContour()
                    *BeginSelection(Part, SelectVisible, "User_Set", 0)
                        *Add("all")
                    *EndSelection()
                    *ResultType("Element Stresses (2D & 3D)")
                    *DataComponent("YY")
                    *MultipleLayers("true")
                    *Layer("Z2,Z1")
                    *LayerFilter(0)
                    *ComplexFilter("mag")
                    *ResolvedInSystem(0)
                    *AverageAcrossParts(Off)
                    *ShowMidsideNodeResults(On)
                    *FeatureAngleAverage(Off, 50, On)
                    *DiscreteColor(yes)
                    *BeginLegend()
                        *LegendType("static")
                        *NumCols(9)
                        *MinMax(-1.3353e+07, 1.3353e+07)
                        *ColorRGB("0 0 200", 
                                  "21 121 255", 
                                  "0 199 221", 
                                  "40 255 185", 
                                  "57 255 0", 
                                  "170 255 0", 
                                  "255 227 0", 
                                  "255 113 0", 
                                  "255 0 0")
                        *NoResultColor("192 192 192")
                        *HeaderFont("Noto Sans", 10, "255 255 255", "left", "bottom", "0", "0")
                        *HeaderText("hide", "")
                        *FooterFont("Noto Sans", 10, "255 255 255", "left", "bottom", "0", "0")
                        *FooterText("hide", "")
                        *TitleFont("Noto Sans", 10, "255 255 255", "left", "bottom", "0", "0")
                        *Title("show", 1, "title")
                        *Numbers("show", "scientific", 3)
                        *NumbersFont("Noto Sans", 10, "255 255 255", "left", "bottom", "0", "0")
                        *ShowMax("show")
                        *ShowMaxLocal("hide")
                        *ShowMin("show")
                        *ShowMinLocal("hide")
                        *EntityLabel("show")
                        *ShowByModel("hide")
                        *LegendPosition("UpperLeft")
                        *BackGroundColor(" 44  85 126")
                        *Transparency("On")
                        *Filter("LINEAR")
                    *EndLegend()
                *EndContour()
                *BeginDeformed()
                    *ScaleMode("ScaleFactor")
                    *Scale("1.000000 1.000000 1.000000")
                    *ResolvedInSystem(0)
                    *ResultType("Displacement")
                    *UndeformedMode("None")
                    *UndeformedColor("componentcolor")
                    *UndeformedTracking("off")
                *EndDeformed()
                *BeginResultMath()
                *EndResultMath()
                *LayerNumber(0)
            *EndModel()
            *BeginModel({GRAPHIC_FILE_1}, "OptiStruct Input Reader")
                *GlobalProperty("Convert 2nd order elements to 1st order elements", "No")
                *ReaderProperty("Model Organization", "By HM Comments")
                *ReaderProperty("Read ANSA Comments", "ON")
                *ReaderProperty("Read PATRAN Comments", "ON")
                *ReaderProperty("Use drive mapping", "NO")
                *ReaderProperty("Use new Element Pooling Scheme", "OFF")
                *ResultMathTemplate("Standard")
                *ComplexAnimFilter("mag * cos(wt+phase)")
                *ColorBy("Part")
                *Color("255   0   0")
                *GradientColor("Off")
                *SmallDeformation("Off")
                *PartDisplayAttribute("undefined", "undefined")
                *BeginResult({RESULT_FILE_1}, "Hyper3D Reader")
                    *CurrentSubcase(1, 0)
                    *ReaderProperty("Model Organization", "Default")
                    *ReaderProperty("Read Systems", "Default")
                *EndResult()
                *BeginPart(1, "Part", "PART", 0)
                    *Attribute(On, IdOff, #cccccc, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginPart(2, "Part", "PART", 0)
                    *Attribute(On, IdOff, #0000ff, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginPart(3, "Part", "PART", 0)
                    *Attribute(On, IdOff, #ffff00, Opa, Sha, NoL, InFit, InCut, InIso)
                *EndPart()
                *BeginGroup("0D Set", "Off", "Off", "255   0   0", 1, "wire")
                    *BeginSelection(Part, SelectAll, "User_Set", 1)
                        *Add("dimension == 0")
                    *EndSelection()
                *EndGroup()
                *BeginGroup("1D Set", "Off", "Off", "  0 255   0", 1, "wire")
                    *BeginSelection(Part, SelectAll, "User_Set", 2)
                        *Add("dimension == 1")
                    *EndSelection()
                *EndGroup()
                *BeginGroup("2D Set", "Off", "Off", "  0   0 255", 1, "wire")
                    *BeginSelection(Part, SelectAll, "User_Set", 3)
                        *Add("dimension == 2")
                    *EndSelection()
                *EndGroup()
                *BeginGroup("3D Set", "Off", "Off", "255 255   0", 1, "wire")
                    *BeginSelection(Part, SelectAll, "User_Set", 4)
                        *Add("dimension == 3")
                    *EndSelection()
                *EndGroup()
                *BeginDeformed()
                    *ScaleMode("ScaleFactor")
                    *Scale("1.000000 1.000000 1.000000")
                    *ResolvedInSystem(0)
                    *ResultType("Displacement")
                    *UndeformedMode("None")
                    *UndeformedColor("componentcolor")
                    *UndeformedTracking("off")
                *EndDeformed()
                *BeginResultMath()
                *EndResultMath()
                *LayerNumber(0)
            *EndModel()
            *RenderOptions("None", "ClipTransparencyOff")
            *DisplayOptions("ContourOn", "LegendOn", "MeasuresOn", "NotesOn")
            *BeginNote("On", "Model Info")
                *Transparent("On")
                *AutoHide("Off")
                *AnchorToScreen("On")
                *FillColor(" 44  85 126")
                *TextColor("  0   0   0")
                *Attach("WINDOW")
                *Position(0.500000, 0.500000)
                *Text("{for (i = 0; i != numpts(window.modeltitlelist); ++i) }\n{window.modelidlist[i]}: {window.modeltitlelist[i]}\n{window.loadcaselist[i]} : {window.simulationsteplist[i]} : {window.framelist[i]}\n{endloop}")
                *Font("Noto Sans", "regular", "regular", 10)
                *Color("  0   0   0")
                *BorderWidth(0)
                *Shape("Rectangle")
                *NoteAlignment("Right")
                *NoteAnchor("Right", "Top")
                *TitleFlag("Yes")
            *EndNote()
            *Preferences(0, 31, 10, 0, 2, 3, 4, TriadOn, 30, "TopToBottom", "Off", "Auto", 30, "Off")
            *CurrentModel(2)
            *BeginSavedView("Current View")
                *ProjectionType("Orthographic")
                *View("-0.758753 -0.260845 0.596870 0.000000 0.651247 -0.285335 0.703180 0.000000 -0.013113 0.922249 0.386374 0.000000 0.000000 0.000000 0.000000 1.000000")
                *ClippingRegion("-0.759484 0.758251 -0.334857 0.425148 -0.733824 0.771716")
            *EndSavedView()
        *EndGraphic()
    *EndWindow()
    *TimeScales(1, 1)
    *TimeDelays(0, 0)
    *AnimationEnable(1, 1)
    *SyncTolerance(2e-08)
    *SyncTableGenerationPolicy(ALL_BLOCKS)
    *PageAnimationSyncPolicy(CLOSEST)
*EndPage()
